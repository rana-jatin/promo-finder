# Copy to .env and fill in. Never commit .env.
# Which keys you need depends on llm.routes in config.yaml (CLI) and config.cloud.yaml (web app).

GEMINI_API_KEY=
GROQ_API_KEY=
# OpenAI direct (judge route in config.yaml reads it through api_key_env)
OPEN_API_KEY=

# Web app (server.py) only
# DEMO_PASSCODE unlocks uploads on the server's keys; unset = uploads need the visitor's own key.
DEMO_PASSCODE=
